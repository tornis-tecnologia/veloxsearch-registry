{
  "description": "splunk-hec/events: lift event, host, source, sourcetype, index and fields into ECS-style fields",
  "processors": [
    {
      "script": {
        "tag": "ts_pick",
        "if": "ctx['time'] != null",
        "lang": "painless",
        "source": "String[] keys = new String[]{'time'}; for (int i = 0; i < keys.length; i++) { def v = ctx[keys[i]]; if (v == null) { continue; } if (v instanceof Number) { double d = v.doubleValue(); ctx._ts_ms = (long)(d >= 1.0E11 ? d : d * 1000.0); } else { String s = v.toString().trim(); try { double d = Double.parseDouble(s); ctx._ts_ms = (long)(d >= 1.0E11 ? d : d * 1000.0); } catch (NumberFormatException e) { ctx._ts_iso = s; } } break; }"
      }
    },
    {
      "date": {
        "tag": "ts_iso",
        "field": "_ts_iso",
        "target_field": "@timestamp",
        "formats": [
          "ISO8601",
          "yyyy-MM-dd HH:mm:ss",
          "yyyy-MM-dd HH:mm:ss.SSS"
        ],
        "if": "ctx._ts_iso != null",
        "ignore_failure": true
      }
    },
    {
      "date": {
        "tag": "ts_epoch",
        "field": "_ts_ms",
        "target_field": "@timestamp",
        "formats": [
          "UNIX_MS"
        ],
        "if": "ctx._ts_ms != null",
        "ignore_failure": true
      }
    },
    {
      "script": {
        "tag": "host_name",
        "lang": "painless",
        "if": "ctx.host != null && !(ctx.host instanceof Map)",
        "source": "ctx.host = ['name': ctx.host.toString()];"
      }
    },
    {
      "rename": {
        "tag": "source",
        "field": "source",
        "target_field": "splunk.source",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "tag": "sourcetype",
        "field": "sourcetype",
        "target_field": "splunk.sourcetype",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "tag": "index",
        "field": "index",
        "target_field": "splunk.index",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "tag": "fields",
        "field": "fields",
        "target_field": "splunk.fields",
        "if": "ctx.fields instanceof Map",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "tag": "event_object",
        "field": "event",
        "target_field": "splunk.event",
        "if": "ctx.event instanceof Map",
        "ignore_missing": true
      }
    },
    {
      "script": {
        "tag": "event_message",
        "lang": "painless",
        "source": "ctx.message = ctx.event.toString();",
        "if": "ctx.event != null && ctx.message == null"
      }
    },
    {
      "remove": {
        "tag": "drop_event",
        "field": "event",
        "ignore_missing": true
      }
    },
    {
      "set": {
        "tag": "ts_fallback",
        "field": "@timestamp",
        "value": "{{_ingest.timestamp}}",
        "if": "ctx['@timestamp'] == null"
      }
    },
    {
      "remove": {
        "tag": "cleanup",
        "field": [
          "_ts_ms",
          "_ts_iso",
          "time"
        ],
        "ignore_missing": true
      }
    }
  ]
}
