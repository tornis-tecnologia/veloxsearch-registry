{
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 1,
        "number_of_replicas": 1,
        "refresh_interval": "5s"
      }
    },
    "mappings": {
      "dynamic": true,
      "dynamic_templates": [
        {
          "resource_strings": {
            "path_match": "resource.*",
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        {
          "attributes_strings": {
            "path_match": "attributes.*",
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        }
      ],
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "trace_id": {
          "type": "keyword"
        },
        "span_id": {
          "type": "keyword"
        },
        "parent_span_id": {
          "type": "keyword"
        },
        "name": {
          "type": "keyword"
        },
        "kind": {
          "type": "keyword"
        },
        "start": {
          "type": "date"
        },
        "end": {
          "type": "date"
        },
        "duration": {
          "type": "long"
        },
        "status": {
          "properties": {
            "code": {
              "type": "keyword"
            },
            "message": {
              "type": "text"
            }
          }
        },
        "resource": {
          "type": "object",
          "dynamic": true
        },
        "attributes": {
          "type": "object",
          "dynamic": true
        },
        "velox": {
          "properties": {
            "integration": {
              "type": "keyword"
            },
            "stream": {
              "type": "keyword"
            },
            "package_version": {
              "type": "keyword"
            }
          }
        }
      }
    }
  }
}
