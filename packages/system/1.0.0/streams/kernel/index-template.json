{
  "template": {
    "settings": {
      "index": {"number_of_shards": 1, "number_of_replicas": 1}
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "@timestamp": {"type": "date"},
        "message": {"type": "text"},
        "event": {"properties": {"sequence": {"type": "long"}}},
        "log": {
          "properties": {
            "level": {"type": "keyword"},
            "syslog": {"properties": {"priority": {"type": "integer"}}}
          }
        },
        "velox": {
          "properties": {
            "integration": {"type": "keyword"},
            "stream": {"type": "keyword"},
            "package_version": {"type": "keyword"}
          }
        }
      }
    }
  }
}
