{
  "description": "postgres/log: PostgreSQL server log (log_line_prefix '%m [%p] %q%u@%d ')",
  "processors": [
    {
      "script": {
        "tag": "keep_original",
        "lang": "painless",
        "if": "ctx.log != null",
        "source": "if (ctx.event == null) { ctx.event = new HashMap(); } ctx.event.original = ctx.log;"
      }
    },
    {
      "grok": {
        "tag": "parse",
        "field": "log",
        "ignore_missing": true,
        "patterns": [
          "\\A%{TIMESTAMP_ISO8601:_ts} %{PGTZ:_tz} \\[%{POSINT:process.pid:int}\\] (?:%{PGUSER:_user}@%{PGDB:_db} )?%{WORD:_level}:\\s+%{MLDATA:message}\\z"
        ],
        "pattern_definitions": {
          "PGTZ": "[A-Za-z]{1,6}|[+-]\\d{2}(?::?\\d{2})?",
          "PGUSER": "[^\\s@\\[]+|\\[unknown\\]",
          "PGDB": "\\S+",
          "MLDATA": "(?m:.*)"
        },
        "on_failure": [
          {
            "rename": {
              "field": "log",
              "target_field": "message",
              "ignore_missing": true
            }
          },
          {
            "set": {
              "field": "event.outcome",
              "value": "unparsed"
            }
          }
        ]
      }
    },
    {
      "remove": {
        "tag": "cleanup",
        "field": "log",
        "ignore_missing": true
      }
    },
    {
      "script": {
        "tag": "user_db",
        "if": "ctx._user != null || ctx._db != null",
        "lang": "painless",
        "source": "if (ctx._user != null && ctx._user != '[unknown]') { if (ctx.user == null) { ctx.user = new HashMap(); } ctx.user.name = ctx._user; } if (ctx._db != null && ctx._db != '[unknown]') { if (ctx.postgres == null) { ctx.postgres = new HashMap(); } ctx.postgres.database = ctx._db; }"
      }
    },
    {
      "grok": {
        "tag": "duration",
        "field": "message",
        "if": "ctx.message != null && ctx.message.startsWith('duration: ')",
        "ignore_failure": true,
        "patterns": [
          "\\Aduration: %{NUMBER:_dur} ms(?:\\s+(?:statement|execute [^:]+|parse [^:]+|bind [^:]+): %{MLDATA:postgres.statement})?"
        ],
        "pattern_definitions": {
          "MLDATA": "(?m:.*)"
        }
      }
    },
    {
      "script": {
        "tag": "duration_ns",
        "if": "ctx._dur != null",
        "lang": "painless",
        "source": "if (ctx.event == null) { ctx.event = new HashMap(); } ctx.event.duration = Math.round(Double.parseDouble(ctx._dur) * 1000000.0);"
      }
    },
    {
      "grok": {
        "tag": "connection",
        "field": "message",
        "ignore_failure": true,
        "if": "ctx.message != null && ctx.message.startsWith('connection ')",
        "patterns": [
          "\\Aconnection received: host=%{IP:source.ip}(?: port=%{POSINT:source.port:int})?\\s*\\z",
          "\\Aconnection received: host=%{NOTSPACE:source.address}(?: port=%{POSINT:source.port:int})?\\s*\\z",
          "\\Aconnection authorized: user=%{NOTSPACE:user.name}(?: database=%{NOTSPACE:postgres.database})?"
        ]
      }
    },
    {
      "set": {
        "field": "event.action",
        "value": "connection-received",
        "if": "ctx.message != null && ctx.message.startsWith('connection received')"
      }
    },
    {
      "set": {
        "field": "event.action",
        "value": "connection-authorized",
        "if": "ctx.message != null && ctx.message.startsWith('connection authorized')"
      }
    },
    {
      "set": {
        "field": "event.action",
        "value": "disconnection",
        "if": "ctx.message != null && ctx.message.startsWith('disconnection:')"
      }
    },
    {
      "lowercase": {
        "field": "_level",
        "target_field": "log.level",
        "ignore_missing": true
      }
    },
    {
      "gsub": {
        "field": "log.level",
        "pattern": "^debug[1-5]$",
        "replacement": "debug",
        "ignore_missing": true
      }
    },
    {
      "drop": {
        "tag": "drop_info",
        "if": "false"
      }
    },
    {
      "set": {
        "tag": "ts_join",
        "field": "_ts_full",
        "value": "{{_ts}} {{_tz}}",
        "if": "ctx._ts != null && ctx._tz != null"
      }
    },
    {
      "date": {
        "tag": "timestamp",
        "if": "ctx._ts_full != null",
        "field": "_ts_full",
        "formats": [
          "yyyy-MM-dd HH:mm:ss.SSS z",
          "yyyy-MM-dd HH:mm:ss.SSS X",
          "yyyy-MM-dd HH:mm:ss.SSS XX",
          "yyyy-MM-dd HH:mm:ss z",
          "yyyy-MM-dd HH:mm:ss X",
          "yyyy-MM-dd HH:mm:ss XX"
        ],
        "target_field": "@timestamp",
        "on_failure": [
          {
            "remove": {
              "field": "_ts_full",
              "ignore_missing": true
            }
          }
        ]
      }
    },
    {
      "remove": {
        "tag": "cleanup",
        "field": [
          "_ts",
          "_tz",
          "_ts_full",
          "_level",
          "_dur",
          "_user",
          "_db"
        ],
        "ignore_missing": true
      }
    }
  ]
}
