{
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 1,
        "number_of_replicas": 1
      }
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "message": {
          "type": "text"
        },
        "event": {
          "properties": {
            "code": {
              "type": "keyword"
            },
            "provider": {
              "type": "keyword"
            },
            "category": {
              "type": "keyword"
            },
            "outcome": {
              "type": "keyword"
            },
            "original": {
              "type": "text",
              "index": false
            }
          }
        },
        "log": {
          "properties": {
            "level": {
              "type": "keyword"
            }
          }
        },
        "host": {
          "properties": {
            "name": {
              "type": "keyword"
            }
          }
        },
        "user": {
          "properties": {
            "name": {
              "type": "keyword"
            },
            "id": {
              "type": "keyword"
            }
          }
        },
        "winlog": {
          "properties": {
            "channel": {
              "type": "keyword"
            },
            "provider_name": {
              "type": "keyword"
            },
            "provider_guid": {
              "type": "keyword"
            },
            "event_id": {
              "type": "long"
            },
            "level": {
              "type": "integer"
            },
            "record_id": {
              "type": "long"
            },
            "task": {
              "type": "keyword"
            },
            "opcode": {
              "type": "keyword"
            },
            "keywords": {
              "type": "keyword"
            },
            "computer_name": {
              "type": "keyword"
            },
            "string_inserts": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "process": {
              "properties": {
                "pid": {
                  "type": "long"
                },
                "thread": {
                  "properties": {
                    "id": {
                      "type": "long"
                    }
                  }
                }
              }
            }
          }
        },
        "velox": {
          "properties": {
            "integration": {
              "type": "keyword"
            },
            "stream": {
              "type": "keyword"
            },
            "package_version": {
              "type": "keyword"
            }
          }
        }
      }
    }
  }
}
