{
  "description": "custom-logs log stream",
  "processors": [
    {
      "set": {
        "tag": "set_original",
        "field": "event.original",
        "value": "{{log}}",
        "if": "ctx.log != null"
      }
    },
    {
      "rename": {
        "tag": "log_to_message",
        "field": "log",
        "target_field": "message",
        "ignore_missing": true
      }
    },
    {
      "remove": {
        "tag": "remove_original",
        "field": "event.original",
        "ignore_missing": true
      }
    }
  ]
}
