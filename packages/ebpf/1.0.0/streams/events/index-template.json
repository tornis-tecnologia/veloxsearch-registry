{
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 1,
        "number_of_replicas": 1,
        "refresh_interval": "5s"
      }
    },
    "mappings": {
      "dynamic": true,
      "dynamic_templates": [
        {
          "numbers": {
            "match_mapping_type": "long",
            "mapping": {
              "type": "double"
            }
          }
        }
      ],
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "message": {
          "type": "text"
        },
        "event": {
          "properties": {
            "kind": {
              "type": "keyword"
            },
            "module": {
              "type": "keyword"
            },
            "category": {
              "type": "keyword"
            },
            "outcome": {
              "type": "keyword"
            }
          }
        },
        "process": {
          "properties": {
            "pid": {
              "type": "long"
            },
            "name": {
              "type": "keyword"
            }
          }
        },
        "host": {
          "properties": {
            "name": {
              "type": "keyword"
            }
          }
        },
        "velox": {
          "properties": {
            "integration": {
              "type": "keyword"
            },
            "stream": {
              "type": "keyword"
            },
            "package_version": {
              "type": "keyword"
            }
          }
        }
      }
    }
  }
}
