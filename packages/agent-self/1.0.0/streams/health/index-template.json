{
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 1,
        "number_of_replicas": 1
      }
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "message": {
          "type": "text"
        },
        "event": {
          "properties": {
            "outcome": {
              "type": "keyword"
            },
            "category": {
              "type": "keyword"
            }
          }
        },
        "destination": {
          "properties": {
            "address": {
              "type": "keyword"
            },
            "port": {
              "type": "integer"
            }
          }
        },
        "health": {
          "properties": {
            "alive": {
              "type": "boolean"
            }
          }
        },
        "velox": {
          "properties": {
            "integration": {
              "type": "keyword"
            },
            "stream": {
              "type": "keyword"
            },
            "package_version": {
              "type": "keyword"
            }
          }
        }
      }
    }
  }
}
