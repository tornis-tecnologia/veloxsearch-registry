{
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 1,
        "number_of_replicas": 1,
        "refresh_interval": "10s"
      }
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "message": {
          "type": "text"
        },
        "event": {
          "properties": {
            "outcome": {
              "type": "keyword"
            }
          }
        },
        "kubernetes": {
          "properties": {
            "event": {
              "properties": {
                "reason": {
                  "type": "keyword"
                },
                "type": {
                  "type": "keyword"
                },
                "message": {
                  "type": "text"
                },
                "count": {
                  "type": "long"
                },
                "action": {
                  "type": "keyword"
                },
                "reporting_component": {
                  "type": "keyword"
                },
                "first_timestamp": {
                  "type": "date"
                },
                "involved_object": {
                  "properties": {
                    "kind": {
                      "type": "keyword"
                    },
                    "name": {
                      "type": "keyword"
                    },
                    "namespace": {
                      "type": "keyword"
                    },
                    "uid": {
                      "type": "keyword"
                    }
                  }
                },
                "source": {
                  "properties": {
                    "component": {
                      "type": "keyword"
                    },
                    "host": {
                      "type": "keyword"
                    }
                  }
                }
              }
            }
          }
        },
        "velox": {
          "properties": {
            "integration": {
              "type": "keyword"
            },
            "stream": {
              "type": "keyword"
            },
            "package_version": {
              "type": "keyword"
            }
          }
        }
      }
    }
  }
}
