{
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 1,
        "number_of_replicas": 1
      }
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "message": {
          "type": "text"
        },
        "event": {
          "properties": {
            "action": {
              "type": "keyword"
            },
            "category": {
              "type": "keyword"
            },
            "outcome": {
              "type": "keyword"
            },
            "original": {
              "type": "text",
              "index": false
            }
          }
        },
        "container": {
          "properties": {
            "id": {
              "type": "keyword"
            },
            "name": {
              "type": "keyword"
            },
            "image": {
              "properties": {
                "name": {
                  "type": "keyword"
                }
              }
            }
          }
        },
        "docker": {
          "properties": {
            "type": {
              "type": "keyword"
            },
            "scope": {
              "type": "keyword"
            },
            "status": {
              "type": "keyword"
            },
            "exit_code": {
              "type": "integer"
            },
            "actor": {
              "properties": {
                "id": {
                  "type": "keyword"
                },
                "name": {
                  "type": "keyword"
                }
              }
            }
          }
        },
        "velox": {
          "properties": {
            "integration": {
              "type": "keyword"
            },
            "stream": {
              "type": "keyword"
            },
            "package_version": {
              "type": "keyword"
            }
          }
        }
      }
    }
  }
}
