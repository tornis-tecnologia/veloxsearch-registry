{
 "package_id": "ssh",
 "package_version": "1.0.0",
 "spec_version": "2.0",
 "streams": {
  "auth": {
   "enabled": true,
   "input": {
    "paths": [
     "/var/log/auth.log"
    ],
    "read_from_head": true,
    "ignore_older": "14d"
   },
   "processors": [
    {
     "id": "exclude",
     "enabled": true,
     "fields": {
      "rules": [
       "log pam_unix\\(cron:session\\)"
      ]
     }
    }
   ],
   "backend": {
    "delete_after": "180d"
   }
  }
 }
}
