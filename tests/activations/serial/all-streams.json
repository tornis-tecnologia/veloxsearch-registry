{
  "package_id": "serial",
  "package_version": "1.0.0",
  "spec_version": "2.0",
  "streams": {
    "lines": {
      "enabled": true,
      "input": {
        "file": "/dev/ttyACM0",
        "bitrate": 115200,
        "separator": ";",
        "format": "none",
        "min_bytes": 4
      },
      "backend": {
        "delete_after": "14d"
      }
    }
  }
}
