{
  "package_id": "fluent-forward",
  "package_version": "1.0.0",
  "spec_version": "2.0",
  "streams": {
    "logs": {
      "enabled": true,
      "input": {
        "listen": "127.0.0.1",
        "port": 24225,
        "shared_key": {
          "$secret": "forward-key"
        },
        "self_hostname": "velox-agent",
        "buffer_chunk_size": "2M",
        "buffer_max_size": "8M"
      },
      "processors": [
        {
          "id": "exclude",
          "enabled": true,
          "fields": {
            "rules": [
              "message ^DEBUG"
            ]
          }
        },
        {
          "plugin": "throttle",
          "params": {
            "rate": 500,
            "window": 5
          }
        }
      ],
      "backend": {
        "delete_after": "14d"
      }
    }
  }
}
