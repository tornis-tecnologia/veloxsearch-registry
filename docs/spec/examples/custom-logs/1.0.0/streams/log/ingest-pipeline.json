{
  "description": "custom-logs log stream",
  "processors": [
    {
      "script": {
        "tag": "keep_original",
        "if": "ctx.log != null",
        "lang": "painless",
        "source": "ctx.event = ctx.event == null ? new HashMap() : ctx.event; ctx.event.original = ctx.log;"
      }
    },
    {
      "rename": {
        "tag": "log_to_message",
        "field": "log",
        "target_field": "message",
        "ignore_missing": true
      }
    }
  ]
}
