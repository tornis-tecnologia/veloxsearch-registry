{
  "description": "VeloxSearch k8s audit-log pipeline",
  "processors": [
    {
      "json": {
        "add_to_root": true,
        "field": "message",
        "ignore_failure": true
      }
    },
    {
      "date": {
        "field": "requestReceivedTimestamp",
        "formats": [
          "ISO8601"
        ],
        "ignore_failure": true,
        "target_field": "@timestamp"
      }
    }
  ]
}
