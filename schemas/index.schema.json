{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veloxsearch.ai/schemas/registry/2.0/index.schema.json",
  "title": "VeloxSearch registry Spec 2.0 — catalogue (packages/index.json)",
  "description": "Generated by scripts/build_index.py from every package manifest; never edited by hand. A showcase: the signed manifest of each version is the source of truth (docs/spec/README.md §10).",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "generated_at", "packages"],
  "properties": {
    "spec_version": {"const": "2.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "summary", "categories", "latest", "versions"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/package_id"},
          "title": {"$ref": "common.schema.json#/$defs/i18n"},
          "summary": {"$ref": "common.schema.json#/$defs/i18n"},
          "categories": {"type": "array", "items": {"type": "string"}},
          "icon": {"type": "string"},
          "latest": {"$ref": "common.schema.json#/$defs/semver", "description": "Highest `ga` version, or highest version when none is ga."},
          "versions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version", "release", "path", "manifest_sha256",
                "min_mesh_version", "min_agent_version", "min_fluent_bit_version",
                "os", "signals", "event_types"
              ],
              "properties": {
                "version": {"$ref": "common.schema.json#/$defs/semver"},
                "release": {"$ref": "common.schema.json#/$defs/release"},
                "path": {"type": "string", "pattern": "^[a-z0-9-]+/[0-9A-Za-z.+-]+/$"},
                "manifest_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
                "min_mesh_version": {"$ref": "common.schema.json#/$defs/semver"},
                "min_agent_version": {"$ref": "common.schema.json#/$defs/semver"},
                "min_fluent_bit_version": {"$ref": "common.schema.json#/$defs/semver"},
                "os": {"$ref": "common.schema.json#/$defs/os_list"},
                "signals": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/signal"}},
                "event_types": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/event_type"}}
              }
            }
          }
        }
      }
    }
  }
}
